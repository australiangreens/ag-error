{
  "name": "@australiangreens/ag-error",
  "version": "0.4.0",
  "description": "Provides an AgError class to be used as part of a consistent error pattern across AG's backend and frontend js/ts apps.",
  "author": "The Australian Greens <webops@greens.org.au>",
  "contributors": [
    "Anthony Blond <anthony@unfinishedteleporter.com>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/australiangreens/ag-error#readme",
  "repository": "github:australiangreens/ag-error",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:esm": "tsc --project ./tsconfig.json",
    "build:cjs": "tsc --project ./tsconfig-cjs.json",
    "build": "pnpm build:esm && pnpm build:cjs && ./fixup.sh",
    "build:force": "rm -rf ./dist && pnpm build:esm && pnpm build:cjs && ./fixup.sh",
    "lint": "eslint --max-warnings 0 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build:force",
    "release": "node scripts/release.js",
    "ship": "pnpm publish --no-git-checks"
  },
  "devDependencies": {
    "@australiangreens/ag-error-jest": "^0.5.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "jest-extended": "^7.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "jest"
      ]
    },
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
